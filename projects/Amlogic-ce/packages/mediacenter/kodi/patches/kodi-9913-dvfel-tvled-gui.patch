+bool CWinSystemAmlogicGLESContext::DestroyTvledGui()
+{
+  if (m_tvledGuiTexture)
+    glDeleteTextures(1, &m_tvledGuiTexture);
+  if (m_tvledGuiBuffer)
+    glDeleteBuffers(1, &m_tvledGuiBuffer);
+  m_tvledGuiTexture = m_tvledGuiBuffer = 0;
+  m_tvledGuiShader.reset();
+  m_tvledSurfaceWidth = m_tvledSurfaceHeight = 0;
+  m_tvledGuiFailed = false;
+  m_tvledCarrierLocationsLogged = m_tvledCompositeLocationsLogged = false;
+#if defined(GL_KHR_debug)
+  if (m_tvledDebugCallback)
+  {
+    m_tvledDebugCallback(m_tvledSavedDebugCallback, m_tvledSavedDebugUser);
+    if (!m_tvledSavedDebugOutput)
+      glDisable(GL_DEBUG_OUTPUT_KHR);
+    if (!m_tvledSavedDebugSync)
+      glDisable(GL_DEBUG_OUTPUT_SYNCHRONOUS_KHR);
+    m_tvledDebugCallback = nullptr;
+  }
