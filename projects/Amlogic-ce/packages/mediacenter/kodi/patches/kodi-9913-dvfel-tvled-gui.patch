+bool CAMLDRMUtils::SetTvledGuiBlend(bool enabled)
+{
+  std::unique_lock<CCriticalSection> lock(m_drmSection);
+  if (!enabled && m_tvledSavedBlend < 0)
+    return true;
+  if (!m_plane)
+    return false;
+  DrmProp prop;
+  if (!find_drmProp(m_plane->plane_id, DRM_MODE_OBJECT_PLANE, "pixel blend mode", prop))
+    return false;
+  const int current = get_drmProp(m_plane->plane_id, "pixel blend mode", DRM_MODE_OBJECT_PLANE);
+  if (current < 0)
+    return false;
+  uint64_t target = 0;
+  if (enabled)
+  {
+    drmModePropertyPtr definition = drmModeGetProperty(m_fd, prop.id);
+    if (!definition)
+      return false;
+    bool found = false;
+    for (int i = 0; i < definition->count_enums; ++i)
+    {
+      if (StringUtils::EqualsNoCase(definition->enums[i].name, "Pre-multiplied"))
+      {
+        target = definition->enums[i].value;
+        found = true;
+        break;
+      }
+    }
+    drmModeFreeProperty(definition);
+    if (!found)
+      return false;
+    if (m_tvledSavedBlend < 0)
+      m_tvledSavedBlend = current;
+  }
+  else
+    target = static_cast<uint64_t>(m_tvledSavedBlend);
+
+  if (static_cast<uint64_t>(current) != target)
+  {
+    drmModeAtomicReqPtr req = drmModeAtomicAlloc();
+    if (!req)
+      return false;
+    const bool added = drmModeAtomicAddProperty(req, m_plane->plane_id, prop.id, target) >= 0;
+    const bool committed = added && drmModeAtomicCommit(m_fd, req, 0, nullptr) == 0;
+    drmModeAtomicFree(req);
+    if (!committed)
+      return false;
+  }
+  if (get_drmProp(m_plane->plane_id, "pixel blend mode", DRM_MODE_OBJECT_PLANE) !=
+      static_cast<int>(target))
+    return false;
+  if (!enabled)
+    m_tvledSavedBlend = -1;
+  return true;
+}
