 using namespace KODI::WINDOWING::AML;
 using namespace std::chrono_literals;
 
+namespace
+{
+struct GuiCarrierState
+{
+  struct Attribute
+  {
+    GLuint index;
+    GLint enabled, size, type, normalized, stride, buffer;
+    void* pointer;
+  } attributes[2];
+  GLint framebuffer, program, activeTexture, texture, arrayBuffer;
+  GLint viewport[4];
+  GLboolean mask[4];
+  const GLenum caps[6] = {GL_SCISSOR_TEST, GL_DEPTH_TEST, GL_BLEND, GL_DITHER,
+                          GL_CULL_FACE, GL_STENCIL_TEST};
+  GLboolean enabled[6];
+
+  GuiCarrierState(GLuint position, GLuint texcoord)
+  {
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &framebuffer);
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &activeTexture);
+    glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &arrayBuffer);
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+    glActiveTexture(GL_TEXTURE0);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    for (unsigned int i = 0; i < 6; ++i)
+      enabled[i] = glIsEnabled(caps[i]);
+    attributes[0].index = position;
+    attributes[1].index = texcoord;
+    for (auto& a : attributes)
+    {
+      glGetVertexAttribiv(a.index, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &a.enabled);
+      glGetVertexAttribiv(a.index, GL_VERTEX_ATTRIB_ARRAY_SIZE, &a.size);
+      glGetVertexAttribiv(a.index, GL_VERTEX_ATTRIB_ARRAY_TYPE, &a.type);
+      glGetVertexAttribiv(a.index, GL_VERTEX_ATTRIB_ARRAY_NORMALIZED, &a.normalized);
+      glGetVertexAttribiv(a.index, GL_VERTEX_ATTRIB_ARRAY_STRIDE, &a.stride);
+      glGetVertexAttribiv(a.index, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &a.buffer);
+      glGetVertexAttribPointerv(a.index, GL_VERTEX_ATTRIB_ARRAY_POINTER, &a.pointer);
+    }
+  }
+
+  ~GuiCarrierState()
+  {
+    for (const auto& a : attributes)
+    {
+      glBindBuffer(GL_ARRAY_BUFFER, a.buffer);
+      glVertexAttribPointer(a.index, a.size, a.type, a.normalized, a.stride, a.pointer);
+      if (a.enabled)
+        glEnableVertexAttribArray(a.index);
+      else
+        glDisableVertexAttribArray(a.index);
+    }
+    glBindBuffer(GL_ARRAY_BUFFER, arrayBuffer);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glActiveTexture(activeTexture);
+    glUseProgram(program);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    glColorMask(mask[0], mask[1], mask[2], mask[3]);
+    for (unsigned int i = 0; i < 6; ++i)
+    {
+      if (enabled[i])
+        glEnable(caps[i]);
+      else
+        glDisable(caps[i]);
+    }
+  }
+};
+} // namespace
