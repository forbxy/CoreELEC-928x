+  return m_amlDisplay->SetTvledGuiBlend(false);
+}
+
+void CWinSystemAmlogicGLESContext::ClearTvledGui()
+{
+  GLint framebuffer;
+  GLboolean mask[4];
+  GLfloat color[4];
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &framebuffer);
+  glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+  glGetFloatv(GL_COLOR_CLEAR_VALUE, color);
+  const bool scissor = glIsEnabled(GL_SCISSOR_TEST);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glDisable(GL_SCISSOR_TEST);
+  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+  glClearColor(0, 0, 0, 0);
+  glClear(GL_COLOR_BUFFER_BIT);
+  glClearColor(color[0], color[1], color[2], color[3]);
+  glColorMask(mask[0], mask[1], mask[2], mask[3]);
+  if (scissor)
+    glEnable(GL_SCISSOR_TEST);
+  glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+}
+
+bool CWinSystemAmlogicGLESContext::RenderTvledGui()
+{
+  bool inheritedFailure = false;
+  for (unsigned int i = 0; i < 8; ++i)
+  {
+    const GLenum error = glGetError();
+    if (error == GL_NO_ERROR)
+      break;
+    CLog::Log(LOGERROR, "TV-led GUI inherited drawing error {} before carrier pass", error);
+    inheritedFailure = true;
+    if (error == 0x0507 || i == 7)
+      return false;
+  }
+  if (inheritedFailure)
+    return false;
+  const auto checked = [&](const char* stage) {
+    const GLenum error = glGetError();
+    if (error != GL_NO_ERROR)
+      CLog::Log(LOGERROR, "TV-led GUI {}: GL error {}, logical {}x{}, physical {}x{}",
+                stage, error, m_nWidth, m_nHeight, m_tvledSurfaceWidth, m_tvledSurfaceHeight);
+    return error == GL_NO_ERROR;
+  };
+  if (!m_tvledGuiShader || !m_tvledGuiTexture || !m_tvledGuiBuffer ||
+      !m_guiCompositing || m_guiCompositeTransfer != AVCOL_TRC_SMPTE2084 ||
+      m_tvledSurfaceWidth <= 0 || m_tvledSurfaceHeight <= 0)
+    return false;
+  const GLuint program = m_tvledGuiShader->ProgramHandle();
+  const GLint position = glGetAttribLocation(program, "a_pos");
+  const GLint texcoord = glGetAttribLocation(program, "a_tex");
+  if (!m_tvledCarrierLocationsLogged)
+  {
+    CLog::Log(LOGINFO, "TV-led carrier program {}: position {}, texcoord {}", program,
+              position, texcoord);
+    m_tvledCarrierLocationsLogged = true;
+  }
+  if (position < 0 || texcoord < 0)
+    CLog::Log(LOGERROR, "TV-led carrier attributes missing in program {}: {}/{}", program,
+              position, texcoord);
+  if (!checked("carrier attribute locations") || position < 0 || texcoord < 0)
+    return false;
+  const bool rendered = [&]() {
+    GuiCarrierState state(position, texcoord);
+    if (!checked("save carrier state"))
+      return false;
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glBindTexture(GL_TEXTURE_2D, m_tvledGuiTexture);
+    glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, m_nWidth, m_nHeight);
+    if (!checked("copy GUI framebuffer"))
+      return false;
+    glViewport(0, 0, m_tvledSurfaceWidth, m_tvledSurfaceHeight);
+    for (const GLenum cap : state.caps)
+      glDisable(cap);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    if (!m_tvledGuiShader->Enable())
+      return false;
+    glUniform1i(glGetUniformLocation(program, "u_gui"), 0);
+    glUniform2f(glGetUniformLocation(program, "u_guiSize"), m_nWidth, m_nHeight);
+    glUniform2f(glGetUniformLocation(program, "u_outputSize"), m_tvledSurfaceWidth,
+                 m_tvledSurfaceHeight);
+    glUniform1f(glGetUniformLocation(program, "u_limited"), UseLimitedColor() ? 1.0f : 0.0f);
+    int map = 0;
+    std::ifstream mapFile("/storage/dvfel_gui_map");
+    int requestedMap;
+    if (mapFile >> requestedMap && requestedMap >= 0 && requestedMap <= 5)
+      map = requestedMap;
+    glUniform1i(glGetUniformLocation(program, "u_map"), map);
+    glUniform1f(glGetUniformLocation(program, "u_probe"),
+                 access("/storage/dvfel_gui_probe", F_OK) == 0 ? 1.0f : 0.0f);
+    glBindBuffer(GL_ARRAY_BUFFER, m_tvledGuiBuffer);
+    glVertexAttribPointer(position, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(GLfloat), nullptr);
+    glVertexAttribPointer(texcoord, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(GLfloat),
+                          reinterpret_cast<void*>(2 * sizeof(GLfloat)));
+    glEnableVertexAttribArray(position);
+    glEnableVertexAttribArray(texcoord);
+    if (!checked("carrier uniforms and attributes"))
+    {
+      m_tvledGuiShader->Disable();
+      return false;
+    }
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    const bool drawn = checked("carrier draw");
+    m_tvledGuiShader->Disable();
+    const bool disabled = checked("disable carrier program");
+    return drawn && disabled;
+  }();
+  const bool restored = checked("restore carrier state");
+  return rendered && restored;
+}
+
+void CWinSystemAmlogicGLESContext::TraceTvledGuiStage(const char* stage)
+{
+  if (!CAMLDvFelOutput::Active() || !CAMLDvFelOutput::Ready() || m_tvledSurfaceWidth <= 0)
+    return;
+  bool failed = false;
+  for (unsigned int i = 0; i < 8; ++i)
+  {
+    const GLenum error = glGetError();
+    if (error == GL_NO_ERROR)
+      break;
+    CLog::Log(LOGERROR, "TV-led GUI stage {}: GL error {}", stage, error);
+    failed = true;
+  }
+  if (failed && !m_tvledGuiFailed)
+  {
+    m_tvledGuiFailed = true;
+    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_STOP);
+  }
+}
