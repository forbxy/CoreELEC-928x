+
+struct WireState
+{
+  unsigned lastId = 15;
+  bool haveIdentity = false;
+  int packets = 0;
+  uint8_t canonical[FELGPU_HDMI_METADATA_SIZE]{};
+};
+
+void UploadGpuMeta(felgpu* gpu, const felgpu_meta& meta, bool requestedTvled,
+                   bool diagnosticTvled, bool forceRefresh, WireState& wire,
+                   felgpu_meta* effective = nullptr)
+{
+  // Compute backends need the identical upload-only scene/ID/CRC rewrite.
+  // Returning a copy performs no GL work and never changes the parser cache.
+  const auto upload = [&](const felgpu_meta& value) {
+    if (effective)
+      *effective = value;
+    else
+      felgpu_set_meta(gpu, &value);
+  };
+  if (diagnosticTvled)
+  {
+    // Keep ParseRpu's real packets and inherited DM untouched.
+    felgpu_meta diagnostic = meta;
+    diagnostic.hdmi_packets = 1;
+    std::memset(diagnostic.hdmi_metadata, 0, sizeof(diagnostic.hdmi_metadata));
+    std::memcpy(diagnostic.hdmi_metadata, TVLED_PATTERN2_PACKET,
+                sizeof(TVLED_PATTERN2_PACKET));
+    wire.lastId = TVLED_PATTERN2_PACKET[1] >> 4;
+    wire.haveIdentity = false;
+    upload(diagnostic);
+  }
+  else if (requestedTvled && meta.hdmi_packets > 0 &&
+           meta.hdmi_packets <= FELGPU_HDMI_MAX_PACKETS)
+  {
+    // Until a valid carrier has reached display, request sink initialization
+    // on an upload-only copy. The first packet's payload starts at byte 5,
+    // with scene_refresh at payload byte 1. Parsed/cached DM stays untouched.
+    felgpu_meta output = meta;
+    if (forceRefresh)
+      output.hdmi_metadata[6] = 1;
+
+    // Source IDs advance in coded order. The output ID instead identifies
+    // effective display metadata, including the startup scene override.
+    const size_t bytes = meta.hdmi_packets * FELGPU_HDMI_PACKET_SIZE;
+    uint8_t canonical[FELGPU_HDMI_METADATA_SIZE]{};
+    std::memcpy(canonical, output.hdmi_metadata, bytes);
+    for (int p = 0; p < meta.hdmi_packets; p++)
+    {
+      uint8_t* packet = canonical + p * FELGPU_HDMI_PACKET_SIZE;
+      packet[1] = 0;
+      std::memset(packet + 124, 0, 4);
+    }
+    if (!wire.haveIdentity || wire.packets != meta.hdmi_packets ||
+        std::memcmp(wire.canonical, canonical, bytes))
+      wire.lastId = (wire.lastId + 1) & 15;
+    wire.haveIdentity = true;
+    wire.packets = meta.hdmi_packets;
+    std::memcpy(wire.canonical, canonical, sizeof(canonical));
+    for (int p = 0; p < meta.hdmi_packets; p++)
+    {
+      uint8_t* packet = output.hdmi_metadata + p * FELGPU_HDMI_PACKET_SIZE;
+      packet[1] = static_cast<uint8_t>((wire.lastId << 4) | wire.lastId);
+      const uint32_t crc = dvfel_metadata_crc(packet, 124);
+      for (unsigned i = 0; i < 4; i++)
+        packet[124 + i] = static_cast<uint8_t>(crc >> (24 - i * 8));
+    }
+    upload(output);
+  }
+  else
+  {
+    wire.haveIdentity = false;
+    upload(meta);
+  }
+}
 
