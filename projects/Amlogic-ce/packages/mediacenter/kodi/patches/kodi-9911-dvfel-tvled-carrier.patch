+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#pragma once
+
+// One confirmed FEL decoder owns the output session. Native display timing
+// and refresh preferences remain under Kodi's ordinary window lifecycle.
+class CAMLDvFelOutput
+{
+public:
+  // Called only for confirmed FEL, before GPU preparation. True also means
+  // deliberately opted out; Active() distinguishes an actual session.
+  static bool Begin(int width, int height);
+  static void End();
+  static bool Active();
+  static bool Ready();
+  static bool NeedsUpdate();
+
+  // Main/window thread: Prepare precedes a normal modeset; Commit follows a
+  // successful modeset. Never wait for a displayed picture to call Prepare.
+  static bool Prepare(int screenWidth, int screenHeight);
+  static bool Commit();
+
+  // After End, call only after the ordinary GUI modeset completed. Failed
+  // restoration retains its snapshot, without scheduling an automatic modeset
+  // loop. An explicit Finish() can retry after recovery of the failure.
+  static void Finish();
+};
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/tvled_gui_shader.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/tvled_gui_shader.h
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/tvled_gui_shader.h
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+inline constexpr char TVLED_GUI_VERTEX_SHADER[] = R"glsl(#version 100
+precision highp float;
+attribute vec2 a_pos;
+attribute vec2 a_tex;
+varying vec2 v_tex;
+void main()
+{
+  gl_Position = vec4(a_pos, 0.0, 1.0);
+  v_tex = a_tex;
+}
+)glsl";
+
+// GUI filtering happens before packing, on the final physical pixel grid.
+// Hardware then blends these premultiplied bytes, not 12-bit YCbCr samples:
+// intermediate-alpha edges have byte-rounding and 4:2:2 chroma-edge error.
+inline constexpr char TVLED_GUI_CARRIER_SHADER[] = R"glsl(#version 100
+precision highp float;
+varying vec2 v_tex;
+uniform highp sampler2D u_gui;
+uniform vec2 u_guiSize;
+uniform vec2 u_outputSize;
+uniform float u_limited;
+uniform int u_map;
+uniform float u_probe;
+
+vec4 guiAt(float x)
+{
+  vec2 halfTexel = 0.5 / u_guiSize;
+  vec2 uv = clamp(vec2((x + 0.5) / u_outputSize.x, v_tex.y),
+                  halfTexel, vec2(1.0) - halfTexel);
+  vec4 gui = texture2D(u_gui, uv);
+  if (gui.a <= 0.0)
+    return vec4(0.0);
+  vec3 rgb = gui.rgb / gui.a;
+  if (u_limited > 0.5)
+    rgb = (rgb - vec3(16.0 / 255.0)) * (255.0 / 219.0);
+  return vec4(clamp(rgb, 0.0, 1.0), gui.a);
+}
+
+vec3 mapChannels(vec3 rgb)
+{
+  if (u_map == 1) return rgb.rbg;
+  if (u_map == 2) return rgb.grb;
+  if (u_map == 3) return rgb.gbr;
+  if (u_map == 4) return rgb.brg;
+  if (u_map == 5) return rgb.bgr;
+  return rgb;
+}
+
+void main()
+{
+  vec2 p = floor(gl_FragCoord.xy);
+  // Protect all five possible CCM packets, irrespective of scanout Y orientation.
+  float protectedRows = ceil(15360.0 / u_outputSize.x);
+  if (p.y < protectedRows || p.y >= u_outputSize.y - protectedRows)
+  {
+    gl_FragColor = vec4(0.0);
+    return;
+  }
+  vec2 center = floor(u_outputSize * 0.5);
+  if (u_probe > 0.5 && all(greaterThanEqual(p, center - vec2(16.0))) &&
+      all(lessThan(p, center + vec2(16.0))))
+  {
+    gl_FragColor = vec4(mapChannels(vec3(53.0, 167.0, 218.0) / 255.0), 1.0);
+    return;
+  }
+  vec4 gui = guiAt(p.x);
+  if (gui.a <= 0.0)
+  {
+    gl_FragColor = vec4(0.0);
+    return;
+  }
+
+  float pairX = p.x - mod(p.x, 2.0);
+  vec4 a = guiAt(pairX);
+  vec4 b = guiAt(min(pairX + 1.0, u_outputSize.x - 1.0));
+  vec3 pairRgb = (a.rgb * a.a + b.rgb * b.a) / max(a.a + b.a, 1.0e-8);
+  float y = dot(gui.rgb, vec3(0.2627, 0.6780, 0.0593));
+  float pairY = dot(pairRgb, vec3(0.2627, 0.6780, 0.0593));
+  float chroma = mod(p.x, 2.0) < 0.5
+      ? (pairRgb.b - pairY) / 1.8814
+      : (pairRgb.r - pairY) / 1.4746;
+  float y12 = floor(clamp(256.0 + y * 3504.0, 256.0, 3760.0) + 0.5);
+  float c12 = floor(clamp(2048.0 + chroma * 3584.0, 256.0, 3840.0) + 0.5);
+  vec3 carrier = vec3(floor(c12 / 16.0), floor(y12 / 16.0),
+                      mod(c12, 16.0) * 16.0 + mod(y12, 16.0)) / 255.0;
+  gl_FragColor = vec4(mapChannels(carrier) * gui.a, gui.a);
+}
+)glsl";
+
+// The existing composite SRC_ALPHA blend turns this straight PQ result into
+// the premultiplied GUI layer consumed by the carrier pass.
+inline constexpr char TVLED_GUI_PQ_SHADER[] = R"glsl(#version 100
+precision highp float;
+varying vec2 v_tex;
+uniform highp sampler2D u_samp;
+uniform highp sampler2D u_lutDegamma;
+uniform highp sampler2D u_lutTF;
+uniform float u_ootfGamma;
+uniform float u_hlgWhite;
+
+const mat3 bt709_to_bt2020 = mat3(
+  0.6274, 0.0691, 0.0164,
+  0.3293, 0.9195, 0.0880,
+  0.0433, 0.0114, 0.8956
+);
+
+void main()
+{
+  vec4 gui = texture2D(u_samp, v_tex);
+  if (gui.a <= 0.0)
+    discard;
+  vec3 straight = clamp(gui.rgb / gui.a, 0.0, 1.0);
+  vec3 linear = vec3(
+    texture2D(u_lutDegamma, vec2(straight.r, 0.5)).r,
+    texture2D(u_lutDegamma, vec2(straight.g, 0.5)).r,
+    texture2D(u_lutDegamma, vec2(straight.b, 0.5)).r
+  );
+  linear = bt709_to_bt2020 * linear;
+  vec3 result = vec3(
+    texture2D(u_lutTF, vec2(linear.r, 0.5)).r,
+    texture2D(u_lutTF, vec2(linear.g, 0.5)).r,
+    texture2D(u_lutTF, vec2(linear.b, 0.5)).r
+  );
+#ifdef KODI_LIMITED_RANGE
+  result = result * (219.0 / 255.0) + (16.0 / 255.0);
+#endif
+  gl_FragColor = vec4(result, gui.a);
+}
+)glsl";
