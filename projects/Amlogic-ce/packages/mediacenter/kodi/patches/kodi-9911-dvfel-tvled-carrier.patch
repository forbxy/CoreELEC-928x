diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLDvFelOutput.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLDvFelOutput.cpp
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLDvFelOutput.cpp
@@ -0,0 +1,440 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "AMLDvFelOutput.h"
+
+#include "AMLCodec.h" // Existing amvecm PQ control ABI used by this backend.
+#include "dvfel_uapi.h"
+#include "utils/log.h"
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cctype>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <mutex>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <sys/ioctl.h>
+#include <thread>
+#include <unistd.h>
+
+namespace
+{
+constexpr const char* PARAMS = "/sys/module/aml_media/parameters/";
+constexpr const char* DV_MODE = "/sys/class/amdolby_vision/dv_mode";
+constexpr const char* BYPASS = "/sys/class/video/bypass_module";
+constexpr const char* ZORDER = "/sys/class/video/video_zorder";
+constexpr const char* ZOOM = "/sys/class/video/zoom";
+constexpr const char* SCREEN_MODE = "/sys/class/video/screen_mode";
+constexpr const char* AXIS = "/sys/class/video/axis";
+constexpr auto PREPARE_TIMEOUT = std::chrono::milliseconds(1500);
+constexpr auto RETRY_INTERVAL = std::chrono::milliseconds(5);
+
+enum class Phase { Idle, Preparing, Prepared, Playing, Failed, Restoring };
+struct Snapshot
+{
+  int policy = 0;
+  int mode = 5;
+  bool enable = false;
+  int csc = 0;
+  int bypass = 0;
+  int zorder = 0;
+  std::optional<int> zoom;
+  std::optional<int> screenMode;
+  std::optional<std::string> axis;
+  pq_ctrl_s pq{};
+};
+struct Session
+{
+  Phase phase = Phase::Idle;
+  int fd = -1;
+  int pqFd = -1;
+  dvfel_display display{};
+  Snapshot saved{};
+  bool snapshot = false;
+  bool nativeChanged = false;
+  bool controlsChanged = false;
+};
+
+std::mutex sessionMutex;
+Session session;
+std::atomic<bool> active{false};
+std::atomic<bool> ready{false};
+std::atomic<bool> needsUpdate{false};
+
+std::string Parameter(const char* name)
+{
+  return std::string(PARAMS) + name;
+}
+
+// CSysfsPath's typed reader does not reject failbit. These small checked
+// helpers must distinguish a missing/unparseable snapshot from a real zero.
+std::optional<std::string> Read(const std::string& path)
+{
+  const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    return std::nullopt;
+  char buffer[512];
+  ssize_t count;
+  do { count = read(fd, buffer, sizeof(buffer)); } while (count < 0 && errno == EINTR);
+  close(fd);
+  if (count < 0 || count == static_cast<ssize_t>(sizeof(buffer)))
+    return std::nullopt;
+  std::string value(buffer, static_cast<size_t>(count));
+  while (!value.empty() && std::isspace(static_cast<unsigned char>(value.back())))
+    value.pop_back();
+  const auto begin = value.find_first_not_of(" \t\r\n");
+  value.erase(0, begin == std::string::npos ? value.size() : begin);
+  return value;
+}
+
+bool Write(const std::string& path, const std::string& value)
+{
+  const int fd = open(path.c_str(), O_WRONLY | O_CLOEXEC);
+  if (fd < 0)
+    return false;
+  const std::string data = value + '\n';
+  ssize_t count;
+  do { count = write(fd, data.data(), data.size()); } while (count < 0 && errno == EINTR);
+  const bool ok = count == static_cast<ssize_t>(data.size());
+  return close(fd) == 0 && ok;
+}
+
+std::optional<int> Number(const std::string& path, bool bypass = false)
+{
+  auto text = Read(path);
+  if (!text || text->empty())
+    return std::nullopt;
+  const char* first = text->c_str();
+  if (bypass && text->rfind("bypass module:", 0) == 0)
+    first += std::strlen("bypass module:");
+  errno = 0;
+  char* end = nullptr;
+  const long value = std::strtol(first, &end, bypass ? 0 : 10);
+  if (errno || end == first || value < 0 || value > 65535 ||
+      (*end && !(bypass && *end == '(')))
+    return std::nullopt;
+  return static_cast<int>(value);
+}
+
+std::optional<bool> Boolean(const std::string& path)
+{
+  auto text = Read(path);
+  if (text && (*text == "Y" || *text == "1"))
+    return true;
+  if (text && (*text == "N" || *text == "0"))
+    return false;
+  return std::nullopt;
+}
+
+bool SetNumber(const std::string& path, int value, bool bypass = false)
+{
+  return Write(path, std::to_string(value)) && Number(path, bypass) == value;
+}
+
+bool SetEnable(bool value)
+{
+  const auto path = Parameter("dolby_vision_enable");
+  return Write(path, value ? "Y" : "N") && Boolean(path) == value;
+}
+
+bool SnapshotGeometry()
+{
+  if (access(ZOOM, F_OK) == 0)
+  {
+    session.saved.zoom = Number(ZOOM);
+    if (!session.saved.zoom)
+      return false;
+  }
+  if (access(SCREEN_MODE, F_OK) == 0)
+  {
+    const auto text = Read(SCREEN_MODE);
+    if (!text)
+      return false;
+    const auto colon = text->find(':');
+    const auto prefix = text->substr(0, colon);
+    if (prefix.empty() || prefix.find_first_not_of("0123456789") != std::string::npos)
+      return false;
+    const long mode = std::strtol(prefix.c_str(), nullptr, 10);
+    if (mode < 0 || mode > 17)
+      return false;
+    session.saved.screenMode = static_cast<int>(mode);
+  }
+  if (access(AXIS, F_OK) == 0)
+  {
+    const auto text = Read(AXIS);
+    if (!text)
+      return false;
+    std::istringstream stream(*text);
+    int x1, y1, x2, y2;
+    if (!(stream >> x1 >> y1 >> x2 >> y2) || !(stream >> std::ws).eof())
+      return false;
+    session.saved.axis = std::to_string(x1) + ' ' + std::to_string(y1) + ' ' +
+                         std::to_string(x2) + ' ' + std::to_string(y2);
+  }
+  return true;
+}
+
+bool Pq(unsigned long request, pq_ctrl_s& value)
+{
+  vpp_pq_ctrl_s control{};
+  control.length = sizeof(value);
+  control.ptr = &value;
+  return ioctl(session.pqFd, request, &control) == 0;
+}
+
+bool SetPq(const pq_ctrl_s& value)
+{
+  pq_ctrl_s copy = value;
+  pq_ctrl_s readback{};
+  return Pq(AMVECM_IOC_S_PQ_CTRL, copy) && Pq(AMVECM_IOC_G_PQ_CTRL, readback) &&
+         std::memcmp(&readback, &value, sizeof(value)) == 0;
+}
+
+bool Display(unsigned op)
+{
+  dvfel_display request = session.display;
+  request.op = op;
+  request.flags = 0;
+  if (ioctl(session.fd, DVFEL_IOC_DISPLAY, &request) < 0)
+    return false;
+  session.display = request;
+  return true;
+}
+
+bool TakeSnapshot()
+{
+  const auto policy = Number(Parameter("dolby_vision_policy"));
+  const auto mode = Number(Parameter("dolby_vision_mode"));
+  const auto enable = Boolean(Parameter("dolby_vision_enable"));
+  const auto csc = Number(Parameter("csc_en"));
+  const auto bypass = Number(BYPASS, true);
+  const auto zorder = Number(ZORDER);
+  if (!policy || !mode || !enable || !csc || !bypass || !zorder ||
+      *policy > 2 || *mode > 5 || *bypass > 7 ||
+      (!*enable && *mode != 5))
+    return false;
+  session.pqFd = open("/dev/amvecm", O_RDWR | O_CLOEXEC);
+  if (session.pqFd < 0 || !Pq(AMVECM_IOC_G_PQ_CTRL, session.saved.pq) ||
+      !SnapshotGeometry())
+    return false;
+  session.saved.policy = *policy;
+  session.saved.mode = *mode;
+  session.saved.enable = *enable;
+  session.saved.csc = *csc;
+  session.saved.bypass = *bypass;
+  session.saved.zorder = *zorder;
+  session.snapshot = true;
+  return true;
+}
+
+bool RequestBypass()
+{
+  session.nativeChanged = true;
+  // Class encoding0 is internal BYPASS5.
+  return SetNumber(Parameter("dolby_vision_policy"), 2) && SetEnable(true) &&
+         Write(DV_MODE, "0") && Number(Parameter("dolby_vision_mode")) == 5;
+}
+
+bool RestoreSnapshot()
+{
+  bool ok = true;
+  if (session.controlsChanged)
+  {
+    ok = SetPq(session.saved.pq) && ok;
+    ok = SetNumber(Parameter("csc_en"), session.saved.csc) && ok;
+    ok = SetNumber(BYPASS, session.saved.bypass, true) && ok;
+    ok = SetNumber(ZORDER, session.saved.zorder) && ok;
+    if (session.saved.zoom)
+      ok = SetNumber(ZOOM, *session.saved.zoom) && ok;
+    if (session.saved.screenMode)
+    {
+      const bool written = Write(SCREEN_MODE, std::to_string(*session.saved.screenMode));
+      const auto readback = Read(SCREEN_MODE);
+      const auto expected = std::to_string(*session.saved.screenMode);
+      ok = written && readback && (*readback == expected ||
+           readback->rfind(expected + ':', 0) == 0) && ok;
+    }
+    if (session.saved.axis)
+      ok = Write(AXIS, *session.saved.axis) && Read(AXIS) == session.saved.axis && ok;
+  }
+  if (session.nativeChanged)
+  {
+    // Request the saved mode through the native lifecycle while enabled,
+    // then put back its original policy and enable state. Disabled sessions
+    // with a stale non-BYPASS mode are rejected before Begin mutates anything.
+    static constexpr int classMode[6] = {1, 2, 3, 4, 5, 0};
+    ok = SetNumber(Parameter("dolby_vision_policy"), 2) && ok;
+    ok = SetEnable(true) && ok;
+    ok = Write(DV_MODE, std::to_string(classMode[session.saved.mode])) &&
+         Number(Parameter("dolby_vision_mode")) == session.saved.mode && ok;
+    ok = SetNumber(Parameter("dolby_vision_policy"), session.saved.policy) && ok;
+    ok = SetEnable(session.saved.enable) && ok;
+  }
+  return ok;
+}
+
+void CloseSessionFile()
+{
+  if (session.fd >= 0)
+  {
+    if (!Display(DVFEL_DISPLAY_END))
+      CLog::Log(LOGERROR, "CAMLDvFelOutput: display END failed: {}; closing owner", errno);
+    close(session.fd); // Kernel owner release is the END fallback.
+    session.fd = -1;
+  }
+}
+
+void Reset()
+{
+  if (session.pqFd >= 0)
+    close(session.pqFd);
+  session = {};
+  active = false;
+  ready = false;
+  needsUpdate = false;
+}
+
+bool Fail(const char* operation)
+{
+  // The decoder still owns a raw carrier. Keep Active() true so renderer
+  // visibility/PQ guards remain in force; Stop/End requests normal recovery.
+  ready = false;
+  needsUpdate = false;
+  session.phase = Phase::Failed;
+  CLog::Log(LOGERROR, "CAMLDvFelOutput: {} failed; carrier remains hidden", operation);
+  return false;
+}
+} // namespace
+
+bool CAMLDvFelOutput::Begin(int width, int height)
+{
+  std::lock_guard lock(sessionMutex);
+  if (session.phase != Phase::Idle)
+    return false;
+  if (access("/storage/dvfel_auto_output", F_OK) != 0)
+    return true;
+  const auto enabled = Boolean("/sys/module/dvfel/parameters/tvled");
+  if (enabled && !*enabled)
+    return true;
+  if (!enabled || width <= 0 || height <= 0 ||
+      width > 3840 || height > 2160 || (width & 1) || (height & 1))
+    return false;
+  session.fd = open("/dev/dvfel", O_RDWR | O_CLOEXEC);
+  if (session.fd < 0 || !TakeSnapshot())
+  {
+    if (session.fd >= 0)
+      close(session.fd);
+    Reset();
+    CLog::Log(LOGERROR, "CAMLDvFelOutput: cannot snapshot automatic output session");
+    return false;
+  }
+  session.display.width = width;
+  session.display.height = height;
+  if (!Display(DVFEL_DISPLAY_BEGIN))
+  {
+    close(session.fd);
+    Reset();
+    CLog::Log(LOGERROR, "CAMLDvFelOutput: automatic display protocol unavailable");
+    return false;
+  }
+  session.phase = Phase::Preparing;
+  active = true;
+  ready = false;
+  needsUpdate = true;
+  if (!RequestBypass())
+  {
+    // The caller follows a failed Begin with End; preserve the owned snapshot
+    // until the main thread restores its normal GUI mode and calls Finish.
+    Fail("native BYPASS request");
+    return false;
+  }
+  CLog::Log(LOGINFO, "CAMLDvFelOutput: automatic FEL output requested {}x{}", width, height);
+  return true;
+}
+
+void CAMLDvFelOutput::End()
+{
+  std::lock_guard lock(sessionMutex);
+  if (session.phase == Phase::Idle || session.phase == Phase::Restoring)
+    return;
+  ready = false;
+  active = false;
+  needsUpdate = true;
+  CloseSessionFile(); // Returns the format preference before GUI modesetting.
+  session.phase = Phase::Restoring;
+}
+
+bool CAMLDvFelOutput::Active() { return active.load(); }
+bool CAMLDvFelOutput::Ready() { return ready.load(); }
+bool CAMLDvFelOutput::NeedsUpdate() { return needsUpdate.load(); }
+
+bool CAMLDvFelOutput::Prepare(int screenWidth, int screenHeight)
+{
+  std::lock_guard lock(sessionMutex);
+  if (!active)
+    return session.phase == Phase::Idle || session.phase == Phase::Restoring;
+  if (session.phase == Phase::Failed)
+    return false;
+  ready = false;
+  if (screenWidth != static_cast<int>(session.display.width) ||
+      screenHeight != static_cast<int>(session.display.height))
+    return Fail("non-1:1 output geometry");
+
+  const auto deadline = std::chrono::steady_clock::now() + PREPARE_TIMEOUT;
+  // Kernel PREPARE is the authoritative inactive-Core2/3/native-on guard.
+  // It leaves native enabled on EBUSY and only disables after BYPASS finished.
+  while (!Display(DVFEL_DISPLAY_PREPARE))
+  {
+    if ((errno != EBUSY && errno != EAGAIN && errno != EINTR) ||
+        std::chrono::steady_clock::now() >= deadline)
+      return Fail("native BYPASS readiness");
+    std::this_thread::sleep_for(RETRY_INTERVAL);
+  }
+
+  session.controlsChanged = true;
+  pq_ctrl_s bypassPq = session.saved.pq;
+  std::memset(&bypassPq, 0, offsetof(pq_ctrl_s, reserved));
+  if (!SetNumber(Parameter("csc_en"), 0) || !SetNumber(BYPASS, 7, true) ||
+      !SetNumber(ZORDER, 123) || !SetPq(bypassPq))
+    return Fail("carrier processing bypass");
+  session.phase = Phase::Prepared;
+  needsUpdate = true;
+  return true;
+}
+
+bool CAMLDvFelOutput::Commit()
+{
+  std::lock_guard lock(sessionMutex);
+  if (!active)
+    return session.phase == Phase::Idle || session.phase == Phase::Restoring;
+  if (session.phase != Phase::Prepared || !Display(DVFEL_DISPLAY_READY))
+    return Fail("normal mode completion");
+  session.phase = Phase::Playing;
+  ready = true;
+  needsUpdate = false;
+  CLog::Log(LOGINFO, "CAMLDvFelOutput: normal display transaction ready");
+  return true;
+}
+
+void CAMLDvFelOutput::Finish()
+{
+  std::lock_guard lock(sessionMutex);
+  if (active || session.phase != Phase::Restoring)
+    return;
+  if (!session.snapshot || !RestoreSnapshot())
+  {
+    CLog::Log(LOGERROR, "CAMLDvFelOutput: GUI controls restoration failed; snapshot retained");
+    needsUpdate = false; // Retain recovery state without a per-frame modeset loop.
+    return;
+  }
+  Reset();
+  CLog::Log(LOGINFO, "CAMLDvFelOutput: original GUI controls restored");
+}
