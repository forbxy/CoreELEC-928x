--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/dvfel_metadata.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Metadata wire format: ETSI GS CCM 001 V1.1.1, clauses 6.2 and 6.3.
+ * Adapted to libdovi from libreelec-x86-DV/CB1/src/dvbridge_metadata.h.
+ */
+#ifndef DVFEL_METADATA_H
+#define DVFEL_METADATA_H
+
+#include <cstddef>
+#include <cstdint>
+#include <libdovi/rpu_parser.h>
+
+constexpr unsigned DVFEL_METADATA_MAX_PAYLOAD = 512;
+constexpr unsigned DVFEL_METADATA_PACKET_SIZE = 128;
+constexpr unsigned DVFEL_METADATA_MAX_PACKETS = 5;
+
+struct dvfel_metadata
+{
+  uint8_t payload[DVFEL_METADATA_MAX_PAYLOAD];
+  uint32_t payload_size;
+  uint8_t packets[DVFEL_METADATA_MAX_PACKETS * DVFEL_METADATA_PACKET_SIZE];
+  uint32_t packet_count;
+};
+
+// Pure serialization: neither retains nor frees dm. Every pointer in dm must
+// remain valid for this call. Failure clears out and gives a static error string.
+// metadata_id belongs to the output stream, 0..15; the caller advances it when
+// the payload changes. Packets are stored once; the GPU repeats each three times.
+bool dvfel_serialize_metadata(const DoviVdrDmData* dm, unsigned metadata_id,
+                              bool force_refresh, dvfel_metadata* out,
+                              const char** error = nullptr);
+
+// A compressed libdovi DM has zeroed fixed fields. Resolve them from the last
+// full DM, retaining the current DM's IDs, scene flag and extension pointers.
+// resolved borrows current->dm_data; serialize before freeing the current DM.
+// A cache of fixed fields must clear dm_data so it retains no borrowed pointers.
+bool dvfel_resolve_dm(const DoviVdrDmData* current,
+                      const DoviVdrDmData* previous_fixed,
+                      DoviVdrDmData* resolved, const char** error = nullptr);
+
+// CRC-32/MPEG-2: initial ffffffff, polynomial 04c11db7, no final xor.
+uint32_t dvfel_metadata_crc(const uint8_t* bytes, size_t size);
+
+#endif
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/felcl.c b/xbmc/cores/VideoPlayer/DVDCodecs/Video/felcl.c
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/felcl.c
@@ -0,0 +1,396 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Exact neutral-EL content fast path. All APIs run on one owning GPU thread.
+ */
+#define _GNU_SOURCE
+#define CL_TARGET_OPENCL_VERSION 120
+#include <CL/cl.h>
+#include <CL/cl_ext.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include "felcl.h"
+#include "felgpu.h"
+#include "felcl-kernels.h"
+
+#define SLOTS 8
+#define APIS(X) \
+    X(GetPlatformIDs) X(GetDeviceIDs) X(GetDeviceInfo) X(CreateContext) \
+    X(CreateCommandQueue) X(CreateProgramWithSource) X(BuildProgram) \
+    X(GetProgramBuildInfo) X(CreateKernel) X(GetKernelWorkGroupInfo) \
+    X(CreateBuffer) X(GetMemObjectInfo) X(SetKernelArg) X(EnqueueFillBuffer) \
+    X(EnqueueNDRangeKernel) X(EnqueueReadBuffer) X(EnqueueWriteBuffer) X(Finish) \
+    X(ReleaseMemObject) X(ReleaseKernel) X(ReleaseProgram) \
+    X(ReleaseCommandQueue) X(ReleaseContext) X(GetExtensionFunctionAddressForPlatform)
+
+struct imported { cl_mem mem; int fd; size_t bytes; };
+struct felcl {
+    void *library;
+    struct {
+#define FIELD(name) __typeof__(&cl##name) name;
+        APIS(FIELD)
+#undef FIELD
+        clImportMemoryARM_fn ImportMemoryARM;
+    } api;
+    cl_platform_id platform;
+    cl_device_id device;
+    cl_context context;
+    cl_command_queue queue;
+    cl_program program;
+    cl_kernel detector, output;
+    cl_mem flag, weights, bases, metadata;
+    struct imported bl[SLOTS], el[SLOTS], out[SLOTS];
+    unsigned inputs, outputs, stride;
+    enum felcl_layout layout;
+    enum felcl_import_mode import_mode;
+    int width, height, poisoned, meta_ready, cached_packets;
+    uint8_t cached_metadata[FELGPU_HDMI_METADATA_SIZE];
+    struct felcl_stats stats;
+    uint64_t timed;
+    double wall_total;
+    char error[192];
+};
+
+static double clock_ms(void)
+{
+    struct timespec value;
+    clock_gettime(CLOCK_MONOTONIC, &value);
+    return value.tv_sec*1000.0+value.tv_nsec/1e6;
+}
+
+static void error_cl(struct felcl *f,const char *stage,cl_int error)
+{
+    f->stats.errors++;f->stats.last_cl_error=error;
+    snprintf(f->error,sizeof(f->error),"%s: OpenCL status=%d",stage,error);
+}
+
+static void error_sys(struct felcl *f,const char *stage)
+{
+    f->stats.errors++;f->stats.last_cl_error=0;
+    snprintf(f->error,sizeof(f->error),"%s: errno=%d",stage,errno);
+}
+
+static int finish(struct felcl *f)
+{
+    if(!f->queue)return 1;
+    cl_int error=f->api.Finish(f->queue);
+    if(error==CL_SUCCESS)return 1;
+    error_cl(f,"clFinish",error);f->stats.undrained++;f->poisoned=1;
+    fprintf(stderr,"felcl: UNDRAINED status=%d; output must not be reused or overwritten\n",error);
+    return FELCL_ERR_UNDRAINED;
+}
+
+static int failed(struct felcl *f)
+{
+    return finish(f)==1?FELCL_ERR:FELCL_ERR_UNDRAINED;
+}
+
+static void release_import(struct felcl *f,struct imported *slot)
+{
+    /* The caller already drained. CL releases its import before fd close. */
+    if(slot->mem)f->api.ReleaseMemObject(slot->mem);
+    if(slot->fd>=0)close(slot->fd);
+    slot->mem=NULL;slot->fd=-1;slot->bytes=0;
+}
+
+static void release_inputs(struct felcl *f)
+{
+    for(unsigned i=0;i<SLOTS;i++){release_import(f,&f->bl[i]);release_import(f,&f->el[i]);}
+    f->inputs=0;
+}
+
+static void release_outputs(struct felcl *f)
+{
+    for(unsigned i=0;i<SLOTS;i++)release_import(f,&f->out[i]);
+    f->outputs=0;
+}
+
+static int extension(const char *list,const char *name)
+{
+    size_t length=strlen(name);const char *at=list;
+    while((at=strstr(at,name))) {
+        if((at==list||at[-1]==' ')&&(!at[length]||at[length]==' '))return 1;
+        at+=length;
+    }
+    return 0;
+}
+
+static int load_device(struct felcl *f)
+{
+    f->library=dlopen("libmali.so",RTLD_NOW|RTLD_LOCAL);
+    if(!f->library)f->library=dlopen("libmali.so.1",RTLD_NOW|RTLD_LOCAL);
+    if(!f->library){snprintf(f->error,sizeof(f->error),"dlopen libmali failed");return 0;}
+#define LOAD(name) do { \
+    f->api.name=(__typeof__(f->api.name))dlsym(f->library,"cl" #name); \
+    if(!f->api.name){snprintf(f->error,sizeof(f->error),"missing OpenCL symbol cl%s",#name);return 0;} \
+} while(0);
+    APIS(LOAD)
+#undef LOAD
+    cl_platform_id platforms[16];cl_uint count=0;
+    cl_int error=f->api.GetPlatformIDs(16,platforms,&count);
+    if(error!=CL_SUCCESS||!count){error_cl(f,"clGetPlatformIDs",error);return 0;}
+    if(count>16)count=16;
+    for(cl_uint i=0;i<count;i++) {
+        cl_device_id devices[8];cl_uint device_count=0;
+        if(f->api.GetDeviceIDs(platforms[i],CL_DEVICE_TYPE_GPU,8,devices,&device_count)!=CL_SUCCESS)continue;
+        if(device_count>8)device_count=8;
+        for(cl_uint j=0;j<device_count;j++) {
+            size_t bytes=0;cl_bool little=CL_FALSE;
+            if(f->api.GetDeviceInfo(devices[j],CL_DEVICE_EXTENSIONS,0,NULL,&bytes)!=CL_SUCCESS||!bytes||bytes>1048576)continue;
+            char *extensions=calloc(bytes+1,1);if(!extensions)continue;
+            int accepted=f->api.GetDeviceInfo(devices[j],CL_DEVICE_EXTENSIONS,bytes,extensions,NULL)==CL_SUCCESS&&
+                         extension(extensions,"cl_arm_import_memory")&&extension(extensions,"cl_arm_import_memory_dma_buf");
+            free(extensions);
+            if(!accepted||f->api.GetDeviceInfo(devices[j],CL_DEVICE_ENDIAN_LITTLE,sizeof(little),&little,NULL)!=CL_SUCCESS||!little)continue;
+            f->platform=platforms[i];f->device=devices[j];break;
+        }
+        if(f->device)break;
+    }
+    if(!f->device){snprintf(f->error,sizeof(f->error),"no little-endian GPU with ARM DMA import");return 0;}
+    f->api.ImportMemoryARM=(clImportMemoryARM_fn)f->api.GetExtensionFunctionAddressForPlatform(f->platform,"clImportMemoryARM");
+    if(!f->api.ImportMemoryARM)f->api.ImportMemoryARM=(clImportMemoryARM_fn)dlsym(f->library,"clImportMemoryARM");
+    if(!f->api.ImportMemoryARM){snprintf(f->error,sizeof(f->error),"clImportMemoryARM unavailable");return 0;}
+    cl_context_properties properties[]={CL_CONTEXT_PLATFORM,(cl_context_properties)f->platform,0};
+    f->context=f->api.CreateContext(properties,1,&f->device,NULL,NULL,&error);
+    if(!f->context||error!=CL_SUCCESS){error_cl(f,"clCreateContext",error);return 0;}
+    f->queue=f->api.CreateCommandQueue(f->context,f->device,0,&error);
+    if(!f->queue||error!=CL_SUCCESS){error_cl(f,"clCreateCommandQueue",error);return 0;}
+    return 1;
+}
+
+static cl_mem make_buffer(struct felcl *f,size_t bytes,void *initial)
+{
+    cl_int error;
+    cl_mem value=f->api.CreateBuffer(f->context,CL_MEM_READ_WRITE|(initial?CL_MEM_COPY_HOST_PTR:0),bytes,initial,&error);
+    if(!value||error!=CL_SUCCESS){error_cl(f,"clCreateBuffer",error);return NULL;}
+    return value;
+}
+
+static int compile_program(struct felcl *f,const float chroma_weights[12],const int chroma_base[2])
+{
+    cl_int error;const char *source=felcl_kernel_source;
+    f->program=f->api.CreateProgramWithSource(f->context,1,&source,NULL,&error);
+    if(!f->program||error!=CL_SUCCESS){error_cl(f,"clCreateProgramWithSource",error);return 0;}
+    error=f->api.BuildProgram(f->program,1,&f->device,"-cl-std=CL1.2",NULL,NULL);
+    if(error!=CL_SUCCESS) {
+        size_t length=0;f->api.GetProgramBuildInfo(f->program,f->device,CL_PROGRAM_BUILD_LOG,0,NULL,&length);
+        if(length&&length<65536) {
+            char *log=calloc(length+1,1);
+            if(log){f->api.GetProgramBuildInfo(f->program,f->device,CL_PROGRAM_BUILD_LOG,length,log,NULL);fprintf(stderr,"felcl: build log: %s\n",log);free(log);}
+        }
+        error_cl(f,"clBuildProgram",error);return 0;
+    }
+    f->detector=f->api.CreateKernel(f->program,"detect_neutral_el",&error);
+    if(!f->detector||error!=CL_SUCCESS){error_cl(f,"clCreateKernel detector",error);return 0;}
+    f->output=f->api.CreateKernel(f->program,"pack_neutral_bgr4",&error);
+    if(!f->output||error!=CL_SUCCESS){error_cl(f,"clCreateKernel output",error);return 0;}
+    cl_kernel kernels[2]={f->detector,f->output};
+    for(int i=0;i<2;i++) {
+        size_t maximum=0;
+        error=f->api.GetKernelWorkGroupInfo(kernels[i],f->device,CL_KERNEL_WORK_GROUP_SIZE,sizeof(maximum),&maximum,NULL);
+        if(error!=CL_SUCCESS||maximum<(i?64u:128u)){error_cl(f,"kernel workgroup limit",error);return 0;}
+    }
+    float weights[60]={0};int bases[10]={0};cl_uint zero=0;
+    memcpy(weights+48,chroma_weights,12*sizeof(float));memcpy(bases+8,chroma_base,2*sizeof(int));
+    f->weights=make_buffer(f,sizeof(weights),weights);if(!f->weights)return 0;
+    f->bases=make_buffer(f,sizeof(bases),bases);if(!f->bases)return 0;
+    f->flag=make_buffer(f,sizeof(zero),&zero);if(!f->flag)return 0;
+    f->metadata=make_buffer(f,FELGPU_HDMI_METADATA_SIZE,NULL);if(!f->metadata)return 0;
+    return 1;
+}
+
+struct felcl *felcl_create_with_import(int width,int height,int taps,const float weights[12],const int bases[2],
+                                      enum felcl_import_mode import_mode)
+{
+    if((import_mode!=FELCL_ARM_HOST_CONSISTENT&&import_mode!=FELCL_ARM_DEVICE)||
+       width<=0||height<=0||width%128||height%2||taps!=4||!weights||!bases||bases[1]!=-1||
+       (uint64_t)width*height>INT_MAX)return NULL;
+    for(int i=0;i<12;i++)if(!isfinite(weights[i]))return NULL;
+    struct felcl *f=calloc(1,sizeof(*f));if(!f)return NULL;
+    for(unsigned i=0;i<SLOTS;i++)f->bl[i].fd=f->el[i].fd=f->out[i].fd=-1;
+    f->width=width;f->height=height;snprintf(f->error,sizeof(f->error),"ok");
+    f->import_mode=import_mode;
+    if(!load_device(f)||!compile_program(f,weights,bases)) {
+        fprintf(stderr,"felcl: create failed: %s\n",f->error);felcl_destroy(f);return NULL;
+    }
+    return f;
+}
+
+struct felcl *felcl_create(int width,int height,int taps,const float weights[12],const int bases[2])
+{
+    return felcl_create_with_import(width,height,taps,weights,bases,FELCL_ARM_HOST_CONSISTENT);
+}
+
+static int import_fd(struct felcl *f,struct imported *slot,int source_fd,size_t minimum)
+{
+    slot->fd=fcntl(source_fd,F_DUPFD_CLOEXEC,3);
+    if(slot->fd<0){error_sys(f,"dup DMA fd");return 0;}
+    off_t size=lseek(slot->fd,0,SEEK_END);
+    if(size<=0||(uintmax_t)size>SIZE_MAX||(uintmax_t)size<minimum) {
+        error_cl(f,"DMA allocation size",CL_INVALID_BUFFER_SIZE);release_import(f,slot);return 0;
+    }
+    slot->bytes=(size_t)size;
+    const cl_import_properties_arm host_properties[]={CL_IMPORT_TYPE_ARM,CL_IMPORT_TYPE_DMA_BUF_ARM,
+        CL_IMPORT_DMA_BUF_DATA_CONSISTENCY_WITH_HOST_ARM,CL_TRUE,0};
+    const cl_import_properties_arm device_properties[]={CL_IMPORT_TYPE_ARM,CL_IMPORT_TYPE_DMA_BUF_ARM,0};
+    const cl_import_properties_arm *properties=f->import_mode==FELCL_ARM_DEVICE?device_properties:host_properties;
+    cl_int error;
+    slot->mem=f->api.ImportMemoryARM(f->context,CL_MEM_READ_WRITE,properties,&slot->fd,slot->bytes,&error);
+    if(!slot->mem||error!=CL_SUCCESS) {
+        error_cl(f,f->import_mode==FELCL_ARM_DEVICE?"clImportMemoryARM device DMA":"clImportMemoryARM host-consistent DMA",error);release_import(f,slot);return 0;
+    }
+    size_t imported_bytes=0;
+    error=f->api.GetMemObjectInfo(slot->mem,CL_MEM_SIZE,sizeof(imported_bytes),&imported_bytes,NULL);
+    if(error!=CL_SUCCESS||imported_bytes!=slot->bytes) {
+        error_cl(f,"imported DMA size mismatch",error==CL_SUCCESS?CL_INVALID_BUFFER_SIZE:error);
+        release_import(f,slot);return 0;
+    }
+    return 1;
+}
+
+int felcl_bind_inputs(struct felcl *f,const int *bl_fds,const int *el_fds,unsigned count)
+{
+    if(!f)return FELCL_ERR;
+    if(f->poisoned)return FELCL_ERR_UNDRAINED;
+    if(finish(f)!=1)return FELCL_ERR_UNDRAINED;
+    if(!bl_fds||!el_fds||!count||count>SLOTS){error_cl(f,"input binding arguments",CL_INVALID_VALUE);return FELCL_ERR;}
+    release_inputs(f);
+    size_t pixels=(size_t)f->width*f->height;
+    for(unsigned i=0;i<count;i++) {
+        if(!import_fd(f,&f->bl[i],bl_fds[i],pixels*4)||!import_fd(f,&f->el[i],el_fds[i],pixels)) {
+            int result=failed(f);if(result!=FELCL_ERR_UNDRAINED)release_inputs(f);return result;
+        }
+        f->stats.input_imports+=2;
+    }
+    f->inputs=count;return 1;
+}
+
+int felcl_bind_outputs(struct felcl *f,const int *fds,unsigned count,unsigned stride,enum felcl_layout layout)
+{
+    if(!f)return FELCL_ERR;
+    if(f->poisoned)return FELCL_ERR_UNDRAINED;
+    if(finish(f)!=1)return FELCL_ERR_UNDRAINED;
+    unsigned bytes_per_pixel=layout==FELCL_RGBA8?4:3;
+    if(!fds||!count||count>SLOTS||(layout!=FELCL_RGBA8&&layout!=FELCL_BGR24)||
+       stride%4||(uint64_t)stride<(uint64_t)f->width*bytes_per_pixel||
+       (uint64_t)stride*f->height>SIZE_MAX||(uint64_t)(stride/4)*f->height>INT_MAX) {
+        error_cl(f,"output binding arguments/stride",CL_INVALID_VALUE);return FELCL_ERR;
+    }
+    release_outputs(f);
+    for(unsigned i=0;i<count;i++) {
+        if(!import_fd(f,&f->out[i],fds[i],(size_t)stride*f->height)) {
+            int result=failed(f);if(result!=FELCL_ERR_UNDRAINED)release_outputs(f);return result;
+        }
+        f->stats.output_imports++;
+    }
+    f->outputs=count;f->stride=stride;f->layout=layout;return 1;
+}
+
+int felcl_set_meta(struct felcl *f,const struct felgpu_meta *meta)
+{
+    if(!f)return FELCL_ERR;
+    if(f->poisoned)return FELCL_ERR_UNDRAINED;
+    f->meta_ready=0;
+    if(!meta||!felgpu_supports_arithmetic_meta(meta)||meta->hdmi_packets<1||
+       meta->hdmi_packets>FELGPU_HDMI_MAX_PACKETS||
+       (uint64_t)f->width*f->height<(uint64_t)meta->hdmi_packets*3072) {
+        f->stats.unsupported++;return 0;
+    }
+    size_t bytes=(size_t)meta->hdmi_packets*FELGPU_HDMI_PACKET_SIZE;
+    if(f->cached_packets!=meta->hdmi_packets||memcmp(f->cached_metadata,meta->hdmi_metadata,bytes)) {
+        cl_int error=f->api.EnqueueWriteBuffer(f->queue,f->metadata,CL_TRUE,0,bytes,meta->hdmi_metadata,0,NULL,NULL);
+        if(error!=CL_SUCCESS){error_cl(f,"metadata upload",error);return failed(f);}
+        memcpy(f->cached_metadata,meta->hdmi_metadata,bytes);f->cached_packets=meta->hdmi_packets;
+    }
+    f->meta_ready=1;return 1;
+}
+
+static int process_args(struct felcl *f,unsigned input,unsigned output)
+{
+    cl_uint words=(cl_uint)((size_t)f->width*f->height/4),packets=(cl_uint)f->cached_packets;
+    cl_uint stride_words=f->stride/4,layout=(cl_uint)f->layout;
+    cl_int error;
+#define ARG(kernel,index,value) do { \
+    error=f->api.SetKernelArg(kernel,index,sizeof(value),&(value)); \
+    if(error!=CL_SUCCESS){error_cl(f,"clSetKernelArg",error);return 0;} \
+} while(0)
+    ARG(f->detector,0,f->el[input].mem);ARG(f->detector,1,f->flag);ARG(f->detector,2,words);
+    ARG(f->output,0,f->bl[input].mem);ARG(f->output,1,f->metadata);ARG(f->output,2,f->out[output].mem);
+    ARG(f->output,3,f->weights);ARG(f->output,4,f->bases);ARG(f->output,5,f->width);ARG(f->output,6,f->height);
+    ARG(f->output,7,packets);ARG(f->output,8,stride_words);ARG(f->output,9,layout);
+#undef ARG
+    return 1;
+}
+
+static int timed_result(struct felcl *f,double began,int result)
+{
+    f->stats.last_wall_ms=clock_ms()-began;f->wall_total+=f->stats.last_wall_ms;f->timed++;
+    f->stats.mean_wall_ms=f->wall_total/f->timed;
+    return result;
+}
+
+int felcl_process(struct felcl *f,unsigned input,unsigned output)
+{
+    if(!f)return FELCL_ERR;
+    if(f->poisoned)return FELCL_ERR_UNDRAINED;
+    f->stats.calls++;
+    if(!f->meta_ready){f->stats.unsupported++;return 0;}
+    if(input>=f->inputs||output>=f->outputs){error_cl(f,"unbound input/output index",CL_INVALID_VALUE);return failed(f);}
+    double began=clock_ms();
+    if(!process_args(f,input,output))return timed_result(f,began,failed(f));
+    cl_uint zero=0,flag=~0u;cl_int error;
+    const size_t local=128,vectors=((size_t)f->width*f->height/4+3)/4;
+    const size_t global=(vectors+local-1)/local*local;
+#define RUN(expression,stage) do { \
+    error=(expression);if(error!=CL_SUCCESS){error_cl(f,stage,error);return timed_result(f,began,failed(f));} \
+} while(0)
+    RUN(f->api.EnqueueFillBuffer(f->queue,f->flag,&zero,sizeof(zero),0,sizeof(zero),0,NULL,NULL),"clear frame EL flag");
+    RUN(f->api.EnqueueNDRangeKernel(f->queue,f->detector,1,NULL,&global,&local,0,NULL,NULL),"full frame EL detector");
+    RUN(f->api.EnqueueReadBuffer(f->queue,f->flag,CL_TRUE,0,sizeof(flag),&flag,0,NULL,NULL),"read current EL flag");
+    if(flag) {
+        int result=finish(f);if(result!=1)return timed_result(f,began,result);
+        f->stats.nonneutral++;return timed_result(f,began,0);
+    }
+    const size_t output_global[2]={(size_t)f->width/4,(size_t)f->height},output_local[2]={32,2};
+    RUN(f->api.EnqueueNDRangeKernel(f->queue,f->output,2,NULL,output_global,output_local,0,NULL,NULL),"neutral output");
+#undef RUN
+    int result=finish(f);if(result!=1)return timed_result(f,began,result);
+    f->stats.neutral++;return timed_result(f,began,1);
+}
+
+void felcl_destroy(struct felcl *f)
+{
+    if(!f)return;
+    if(finish(f)!=1) {
+        fprintf(stderr,"felcl: UNDRAINED destroy quarantines CL objects and DMA dupfds until process exit\n");
+        return;
+    }
+    release_inputs(f);release_outputs(f);
+    cl_mem buffers[4]={f->flag,f->weights,f->bases,f->metadata};
+    for(int i=0;i<4;i++)if(buffers[i])f->api.ReleaseMemObject(buffers[i]);
+    if(f->detector)f->api.ReleaseKernel(f->detector);
+    if(f->output)f->api.ReleaseKernel(f->output);
+    if(f->program)f->api.ReleaseProgram(f->program);
+    if(f->queue)f->api.ReleaseCommandQueue(f->queue);
+    if(f->context)f->api.ReleaseContext(f->context);
+    if(f->library)dlclose(f->library);
+    free(f);
+}
+
+const char *felcl_last_error(const struct felcl *f)
+{
+    return f?f->error:"backend unavailable; see felcl create log";
+}
+
+void felcl_get_stats(const struct felcl *f,struct felcl_stats *out)
+{
+    if(!out)return;
+    if(f)*out=f->stats;else memset(out,0,sizeof(*out));
+}
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/felcl.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/felcl.h
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/felcl.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef FELCL_H
+#define FELCL_H
+#include <stdint.h>
+struct felgpu_meta;
+struct felcl;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum felcl_layout { FELCL_RGBA8 = 0, FELCL_BGR24 = 1 };
+enum felcl_import_mode {
+    FELCL_ARM_HOST_CONSISTENT = 0,
+    FELCL_ARM_DEVICE = 1
+};
+enum { FELCL_ERR = -1, FELCL_ERR_UNDRAINED = -2 };
+
+struct felcl_stats {
+    uint64_t calls, neutral, nonneutral, unsupported, errors, undrained;
+    uint64_t input_imports, output_imports;
+    double last_wall_ms, mean_wall_ms;
+    int last_cl_error;
+};
+
+/* Call every API on the owning GPU thread. Create compiles before REG/WAIT_JOB.
+ * Only four taps, pattern0/demo0 and the strict identity/NLQ gate are supported;
+ * the caller must exclude diagnostic patterns/demo before choosing this API.
+ * Filters must be copied from felgpu_get_chroma_filter without approximation.
+ */
+struct felcl *felcl_create(int width, int height, int taps,
+                           const float chroma_weights[12], const int chroma_base[2]);
+/* The original constructor always uses HOST_CONSISTENT. DEVICE is an explicit
+ * startup choice for device-owned DMA images: CPU access requires independent
+ * DMA synchronization, and the caller must establish producer/consumer GPU
+ * cache and completion boundaries before any external reuse. It does not
+ * suppress EL checks, change pixels or replace a completion fence.
+ */
+struct felcl *felcl_create_with_import(int width, int height, int taps,
+                           const float chroma_weights[12], const int chroma_base[2],
+                           enum felcl_import_mode import_mode);
+
+/* Each binding owns CLOEXEC dupfd and CL imports. Input BL stride is4*width,
+ * EL is packed RGBA word data at width/2,height/2. FDs must be real dma-bufs;
+ * measured allocation size must cover the complete required image.
+ * Replacement drains first, releases CL objects before closing their dupfds.
+ * Returns1 or FELCL_ERR/FELCL_ERR_UNDRAINED. Count is1..8.
+ */
+int felcl_bind_inputs(struct felcl *f, const int *bl_fds, const int *el_fds, unsigned count);
+int felcl_bind_outputs(struct felcl *f, const int *output_fds, unsigned count,
+                       unsigned stride_bytes, enum felcl_layout layout);
+
+/* Effective, already wire-tagged packets, including startup scene override.
+ * Returns1 if accepted,0 if unsupported (disables processing), or an error.
+ */
+int felcl_set_meta(struct felcl *f, const struct felgpu_meta *effective_meta);
+
+/* 1: complete output with a successful clFinish. 0: unsupported/non-neutral,
+ * and no output write was enqueued. -1: error, all queued work was drained;
+ * GLES fallback may fully overwrite output. -2: clFinish itself failed: no
+ * safe overwrite/reuse of this output until session teardown/quarantine.
+ * The full EL is independently checked on EVERY call; no cached content flag.
+ */
+int felcl_process(struct felcl *f, unsigned input_index, unsigned output_index);
+
+/* destroy retries Finish. An undrainable context deliberately retains its
+ * imported memory and dupfds until process exit, rather than freeing pages
+ * while a device command might still access them.
+ */
+void felcl_destroy(struct felcl *f);
+const char *felcl_last_error(const struct felcl *f);
+void felcl_get_stats(const struct felcl *f, struct felcl_stats *out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
