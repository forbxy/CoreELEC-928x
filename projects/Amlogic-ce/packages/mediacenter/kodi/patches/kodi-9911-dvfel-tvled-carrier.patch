--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/felcl.cl
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Exact neutral4 production subset. The detector and BGR arithmetic follow
+ * the 72-case validated prototype; output layout/stride are explicit.
+ */
+#pragma OPENCL FP_CONTRACT OFF
+
+inline uint embed(uint y, uint c, uint raster, __global const uchar *metadata, uint packets)
+{
+    uint packet = raster / 3072u;
+    if (packet >= packets) return c;
+    uint bit = raster % 1024u;
+    uint data = (metadata[packet * 128u + bit / 8u] >> (7u - bit % 8u)) & 1u;
+    uint parity = (c >> 1u) ^ y;
+    parity ^= parity >> 8u;
+    parity ^= parity >> 4u;
+    parity = (0x6996u >> (parity & 15u)) & 1u;
+    return (c & 0xffeu) | (data ^ parity);
+}
+
+__kernel void detect_neutral_el(__global const uint *el, volatile __global uint *flag, uint words)
+{
+    __local uint differences[128];
+    uint index = get_global_id(0) * 4u, lid = get_local_id(0), different = 0u;
+    if (index + 3u < words) {
+        uint4 delta = (vload4(0, el + index) & 0x3fffffffu) ^ 0x20080200u;
+        different = (delta.x | delta.y | delta.z | delta.w) != 0u;
+    } else {
+        for (uint i = index; i < min(index + 4u, words); i++)
+            different |= ((el[i] & 0x3fffffffu) != 0x20080200u);
+    }
+    differences[lid] = different;
+    barrier(CLK_LOCAL_MEM_FENCE);
+    for (uint stride = 64u; stride; stride >>= 1u) {
+        if (lid < stride) differences[lid] |= differences[lid + stride];
+        barrier(CLK_LOCAL_MEM_FENCE);
+    }
+    if (lid == 0u && differences[0]) atomic_or(flag, 1u);
+}
+
+/* Valid only after this frame's full EL detector returned zero and the
+ * strict identity/NLQ metadata gate succeeded. No filename/content heuristic. */
+__kernel void pack_neutral_bgr4(__global const uint *bl, __global const uchar *metadata,
+                                __global uint *output, __constant float *wt,
+                                __constant int *base, int width, int height, uint packets, uint stride_words, uint layout)
+{
+    int group = get_global_id(0), y = get_global_id(1), x0 = group * 4;
+    uint4 words = vload4(0, bl + y * width + x0);
+    float4 chroma = (float4)(0.0f);
+    if (!(y & 1)) {
+        chroma = convert_float4((uint4)((words.x >> 10) & 1023u, words.x & 1023u,
+                                         (words.z >> 10) & 1023u, words.z & 1023u)) * (1.0f / 1024.0f);
+    } else {
+        int b = (y >> 1) + base[9];
+        for (int k = 0; k < 4; k++) {
+            int row = 2 * clamp(b + k, 0, height / 2 - 1);
+            uint a = bl[row * width + x0], z = bl[row * width + x0 + 2];
+            float4 sample = convert_float4((uint4)((a >> 10) & 1023u, a & 1023u,
+                                                    (z >> 10) & 1023u, z & 1023u)) * (1.0f / 1024.0f);
+            chroma += wt[52 + k] * sample;
+        }
+    }
+    uint4 ys = ((words >> 20) & 1023u) << 2;
+    uint4 cs = convert_uint4(clamp(floor(chroma * 4096.0f + 0.5f), (float4)(0.0f), (float4)(4095.0f)));
+    uint raster = convert_uint(y * width + x0);
+    cs.x = embed(ys.x, cs.x, raster, metadata, packets);
+    cs.y = embed(ys.y, cs.y, raster + 1u, metadata, packets);
+    cs.z = embed(ys.z, cs.z, raster + 2u, metadata, packets);
+    cs.w = embed(ys.w, cs.w, raster + 3u, metadata, packets);
+    if (layout == 0u) {
+        uint4 rgba = (cs >> 4) | ((ys >> 4) << 8) |
+                     ((((cs & 15u) << 4) | (ys & 15u)) << 16) | 0xff000000u;
+        vstore4(rgba, 0, output + (size_t)y * stride_words + group * 4);
+    } else {
+        uint4 packed = (((cs & 15u) << 4) | (ys & 15u)) | ((ys >> 4) << 8) | ((cs >> 4) << 16);
+        size_t at = (size_t)y * stride_words + group * 3;
+        output[at] = packed.x | (packed.y << 24);
+        output[at + 1] = (packed.y >> 8) | (packed.z << 16);
+        output[at + 2] = (packed.z >> 16) | (packed.w << 8);
+    }
+}
