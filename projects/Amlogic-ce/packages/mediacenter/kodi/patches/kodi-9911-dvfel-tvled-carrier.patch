+ * SOFTWARE.
+ */
+#include "dvfel_metadata.h"
+
+#include <cmath>
+#include <cstring>
+
+namespace
+{
+constexpr unsigned MAX_BLOCKS = 32;
+
+bool Fail(const char** error, const char* reason)
+{
+  if (error)
+    *error = reason;
+  return false;
+}
+
+void Put16(uint8_t* p, unsigned value)
+{
+  p[0] = value >> 8;
+  p[1] = value;
+}
+
+void Put32(uint8_t* p, uint32_t value)
+{
+  Put16(p, value >> 16);
+  Put16(p + 2, value);
+}
+
+bool Invertible(const int16_t m[9])
+{
+  // Integer coefficients have an implicit scale, which does not affect rank.
+  const double d = double(m[0]) * (double(m[4]) * m[8] - double(m[5]) * m[7]) -
+                   double(m[1]) * (double(m[3]) * m[8] - double(m[5]) * m[6]) +
+                   double(m[2]) * (double(m[3]) * m[7] - double(m[4]) * m[6]);
+  return std::isfinite(d) && d != 0.0;
+}
+
+struct Writer
+{
+  dvfel_metadata& result;
+
+  bool Block(unsigned level, const uint8_t* bytes, unsigned size)
+  {
+    if (size > 32 || result.payload_size > sizeof(result.payload) - 5 - size ||
+        result.payload[70] >= MAX_BLOCKS)
+      return false;
+    uint8_t* p = result.payload + result.payload_size;
+    Put32(p, size);
+    p[4] = level;
+    std::memcpy(p + 5, bytes, size);
+    result.payload_size += 5 + size;
+    result.payload[70]++;
+    return true;
+  }
+
+  bool Words(unsigned level, const unsigned* values, unsigned count, bool ms_sentinel = false)
+  {
+    if (count > 16)
+      return false;
+    uint8_t bytes[32];
+    for (unsigned i = 0; i < count; i++)
+    {
+      if (values[i] > 4095 && !(ms_sentinel && i + 1 == count && values[i] == 65535))
+        return false;
+      Put16(bytes + 2 * i, values[i]);
+    }
+    return Block(level, bytes, 2 * count);
+  }
+};
+} // namespace
+
+uint32_t dvfel_metadata_crc(const uint8_t* bytes, size_t size)
+{
+  uint32_t crc = 0xffffffffu;
+  for (size_t i = 0; i < size; i++)
+  {
+    crc ^= uint32_t(bytes[i]) << 24;
+    for (unsigned bit = 0; bit < 8; bit++)
+      crc = (crc << 1) ^ ((crc >> 31) ? 0x04c11db7u : 0u);
+  }
+  return crc;
+}
+
+bool dvfel_resolve_dm(const DoviVdrDmData* current,
+                      const DoviVdrDmData* previous_fixed,
+                      DoviVdrDmData* resolved, const char** error)
+{
+  if (error)
+    *error = nullptr;
+  if (!current || !resolved)
+    return Fail(error, "missing DM input or destination");
+  const DoviVdrDmData input = *current;
+  if (!input.compressed)
+  {
+    *resolved = input;
+    return true;
+  }
+  if (!previous_fixed || previous_fixed->compressed || !previous_fixed->signal_bit_depth)
+  {
+    *resolved = {};
+    return Fail(error, "compressed DM has no preceding full fixed fields");
+  }
+  *resolved = *previous_fixed;
+  resolved->compressed = false;
+  resolved->affected_dm_metadata_id = input.affected_dm_metadata_id;
+  resolved->current_dm_metadata_id = input.current_dm_metadata_id;
+  resolved->scene_refresh_flag = input.scene_refresh_flag;
+  resolved->dm_data = input.dm_data;
+  return true;
+}
+
+bool dvfel_serialize_metadata(const DoviVdrDmData* dm, unsigned metadata_id,
+                              bool force_refresh, dvfel_metadata* out,
+                              const char** error)
+{
+  if (error)
+    *error = nullptr;
+  if (!out)
+    return Fail(error, "missing metadata destination");
+  *out = {};
+  if (!dm || dm->compressed)
+    return Fail(error, "missing or unresolved compressed DM");
+  if (metadata_id > 15 || dm->affected_dm_metadata_id > 15 ||
+      dm->current_dm_metadata_id > 15 || dm->scene_refresh_flag > 1)
+    return Fail(error, "DM ID or scene flag outside its wire range");
+  if (dm->signal_bit_depth != 12 || dm->signal_eotf != 65535 ||
+      dm->signal_eotf_param0 || dm->signal_eotf_param1 || dm->signal_eotf_param2 ||
+      (dm->signal_color_space != 0 && dm->signal_color_space != 2) ||
+      dm->signal_chroma_format > 1 || dm->signal_full_range_flag != 1)
+    return Fail(error, "unsupported DM signal encoding");
+  if (dm->source_min_pq > dm->source_max_pq || dm->source_max_pq > 4095 ||
+      dm->source_diagonal > 1023)
+    return Fail(error, "source display values outside their wire range");
+
+  const int16_t ycc[9] = {
+      dm->ycc_to_rgb_coef0, dm->ycc_to_rgb_coef1, dm->ycc_to_rgb_coef2,
+      dm->ycc_to_rgb_coef3, dm->ycc_to_rgb_coef4, dm->ycc_to_rgb_coef5,
+      dm->ycc_to_rgb_coef6, dm->ycc_to_rgb_coef7, dm->ycc_to_rgb_coef8};
+  const int16_t lms[9] = {
+      dm->rgb_to_lms_coef0, dm->rgb_to_lms_coef1, dm->rgb_to_lms_coef2,
+      dm->rgb_to_lms_coef3, dm->rgb_to_lms_coef4, dm->rgb_to_lms_coef5,
+      dm->rgb_to_lms_coef6, dm->rgb_to_lms_coef7, dm->rgb_to_lms_coef8};
+  const uint32_t offsets[3] = {
+      dm->ycc_to_rgb_offset0, dm->ycc_to_rgb_offset1, dm->ycc_to_rgb_offset2};
+  if (!Invertible(ycc) || !Invertible(lms))
+    return Fail(error, "singular DM color matrix");
+  for (unsigned i = 0; i < 3; i++)
+    if (offsets[i] >= (1u << 28))
+      return Fail(error, "DM color offset outside the 28-bit range");
+
+  const DoviDmData& ext = dm->dm_data;
+  if (ext.num_ext_blocks > MAX_BLOCKS || ext.level2.len > MAX_BLOCKS ||
+      ext.level8.len > MAX_BLOCKS || ext.level10.len > MAX_BLOCKS ||
+      (ext.level2.len && !ext.level2.list) ||
+      (ext.level8.len && !ext.level8.list) || (ext.level10.len && !ext.level10.list))
+    return Fail(error, "invalid extension block count or list");
+  const unsigned known = unsigned(ext.level1 != nullptr) + ext.level2.len +
+      unsigned(ext.level3 != nullptr) + unsigned(ext.level4 != nullptr) +
+      unsigned(ext.level5 != nullptr) + unsigned(ext.level6 != nullptr) + ext.level8.len +
+      unsigned(ext.level9 != nullptr) + ext.level10.len + unsigned(ext.level11 != nullptr) +
+      unsigned(ext.level254 != nullptr) + unsigned(ext.level255 != nullptr);
+  if (known != ext.num_ext_blocks || !ext.level1)
+    return Fail(error, "missing level 1 or unsupported/unaccounted extension block");
+
+  dvfel_metadata result{};
+  result.payload_size = 71;
+  uint8_t* base = result.payload;
+  base[1] = force_refresh ? 1 : dm->scene_refresh_flag;
+  for (unsigned i = 0; i < 9; i++)
+  {
+    Put16(base + 2 + 2 * i, uint16_t(ycc[i]));
+    Put16(base + 32 + 2 * i, uint16_t(lms[i]));
+  }
+  for (unsigned i = 0; i < 3; i++)
+    Put32(base + 20 + 4 * i, offsets[i]);
+  Put16(base + 50, 65535);
+  base[60] = 12;
+  base[61] = dm->signal_color_space;
+  base[62] = 1; // The output chroma is 4:2:2, regardless of the source's 4:2:0 flag.
+  base[63] = 1;
+  Put16(base + 64, dm->source_min_pq);
+  Put16(base + 66, dm->source_max_pq);
+  Put16(base + 68, dm->source_diagonal);
+  Writer writer{result};
+
+  const auto& l1 = *ext.level1;
+  const unsigned brightness[3] = {l1.min_pq, l1.max_pq, l1.avg_pq};
+  if (l1.min_pq > l1.avg_pq || l1.avg_pq > l1.max_pq || !writer.Words(1, brightness, 3))
+    return Fail(error, "invalid level 1 or payload capacity exceeded");
+  for (size_t i = 0; i < ext.level2.len; i++)
+  {
+    if (!ext.level2.list[i])
+      return Fail(error, "null level 2 block");
+    const auto& b = *ext.level2.list[i];
+    for (size_t j = 0; j < i; j++)
+      if (ext.level2.list[j]->target_max_pq == b.target_max_pq)
+        return Fail(error, "duplicate level 2 target");
+    const unsigned values[7] = {b.target_max_pq, b.trim_slope, b.trim_offset,
+        b.trim_power, b.trim_chroma_weight, b.trim_saturation_gain, uint16_t(b.ms_weight)};
+    if (!writer.Words(2, values, 7, true))
+      return Fail(error, "invalid level 2 or payload capacity exceeded");
+  }
+  if (ext.level4)
+  {
+    const unsigned values[2] = {ext.level4->anchor_pq, ext.level4->anchor_power};
+    if (!writer.Words(4, values, 2))
+      return Fail(error, "invalid level 4 or payload capacity exceeded");
+  }
+  unsigned margins[4] = {};
+  if (ext.level5)
+  {
+    margins[0] = ext.level5->active_area_left_offset;
+    margins[1] = ext.level5->active_area_right_offset;
+    margins[2] = ext.level5->active_area_top_offset;
+    margins[3] = ext.level5->active_area_bottom_offset;
+  }
+  if (ext.level5 && !writer.Words(5, margins, 4))
+    return Fail(error, "invalid level 5 or payload capacity exceeded");
+  // Level 6 is HDR10 fallback; level 255 is encoder/debug state, not DM wire data.
+  if (ext.level3)
+  {
+    const unsigned values[3] = {ext.level3->min_pq_offset, ext.level3->max_pq_offset,
+                               ext.level3->avg_pq_offset};
+    if (!writer.Words(3, values, 3))
+      return Fail(error, "invalid level 3 or payload capacity exceeded");
+  }
+  for (size_t i = 0; i < ext.level8.len; i++)
+  {
+    if (!ext.level8.list[i])
+      return Fail(error, "null level 8 block");
+    const auto& b = *ext.level8.list[i];
+    if (b.length != 10 && b.length != 12 && b.length != 13 && b.length != 19 && b.length != 25)
+      return Fail(error, "unsupported level 8 length");
+    for (size_t j = 0; j < i; j++)
+      if (ext.level8.list[j]->target_display_index == b.target_display_index)
+        return Fail(error, "duplicate level 8 target");
+    const unsigned values[8] = {b.trim_slope, b.trim_offset, b.trim_power,
+        b.trim_chroma_weight, b.trim_saturation_gain, b.ms_weight,
+        b.target_mid_contrast, b.clip_trim};
+    const unsigned count = b.length == 10 ? 6 : b.length == 12 ? 7 : 8;
+    uint8_t bytes[29] = {b.target_display_index};
+    unsigned size = 1;
+    for (unsigned j = 0; j < count; j++)
+    {
+      if (values[j] > 4095)
+        return Fail(error, "level 8 value outside 12-bit range");
+      Put16(bytes + size, values[j]);
+      size += 2;
+    }
+    if (b.length >= 19)
+    {
+      const uint8_t saturation[6] = {b.saturation_vector_field0, b.saturation_vector_field1,
+          b.saturation_vector_field2, b.saturation_vector_field3,
+          b.saturation_vector_field4, b.saturation_vector_field5};
+      std::memcpy(bytes + size, saturation, 6);
+      size += 6;
+    }
+    if (b.length == 25)
+    {
+      const uint8_t hue[6] = {b.hue_vector_field0, b.hue_vector_field1, b.hue_vector_field2,
+                            b.hue_vector_field3, b.hue_vector_field4, b.hue_vector_field5};
+      std::memcpy(bytes + size, hue, 6);
+      size += 6;
+    }
+    if (!writer.Block(8, bytes, size))
+      return Fail(error, "level 8 payload capacity exceeded");
+  }
+  if (ext.level9)
+  {
+    const auto& b = *ext.level9;
+    if ((b.length != 1 && b.length != 17) || ((b.source_primary_index == 255) != (b.length == 17)))
+      return Fail(error, "level 9 primaries disagree with block length");
+    uint8_t bytes[17] = {b.source_primary_index};
+    const unsigned values[8] = {b.source_primary_red_x, b.source_primary_red_y,
+        b.source_primary_green_x, b.source_primary_green_y, b.source_primary_blue_x,
+        b.source_primary_blue_y, b.source_primary_white_x, b.source_primary_white_y};
+    if (b.length == 17)
+      for (unsigned j = 0; j < 8; j++)
+        Put16(bytes + 1 + 2 * j, values[j]);
+    if (!writer.Block(9, bytes, unsigned(b.length)))
+      return Fail(error, "level 9 payload capacity exceeded");
+  }
+  for (size_t i = 0; i < ext.level10.len; i++)
+  {
+    if (!ext.level10.list[i])
+      return Fail(error, "null level 10 block");
+    const auto& b = *ext.level10.list[i];
+    if ((b.length != 5 && b.length != 21) || ((b.target_primary_index == 255) != (b.length == 21)) ||
+        b.target_max_pq > 4095 || b.target_min_pq > b.target_max_pq)
+      return Fail(error, "invalid level 10 target or length");
+    for (size_t j = 0; j < i; j++)
+      if (ext.level10.list[j]->target_display_index == b.target_display_index)
+        return Fail(error, "duplicate level 10 target");
+    uint8_t bytes[22] = {b.target_display_index};
+    Put16(bytes + 1, b.target_max_pq);
+    Put16(bytes + 3, b.target_min_pq);
+    bytes[5] = b.target_primary_index;
+    const unsigned values[8] = {b.target_primary_red_x, b.target_primary_red_y,
+        b.target_primary_green_x, b.target_primary_green_y, b.target_primary_blue_x,
+        b.target_primary_blue_y, b.target_primary_white_x, b.target_primary_white_y};
+    if (b.length == 21)
+      for (unsigned j = 0; j < 8; j++)
+        Put16(bytes + 6 + 2 * j, values[j]);
+    if (!writer.Block(10, bytes, b.length == 21 ? 22 : 6))
+      return Fail(error, "level 10 payload capacity exceeded");
+  }
+  if (ext.level11)
+  {
+    const auto& b = *ext.level11;
+    if (b.content_type > 15 || b.whitepoint > 15 || b.reserved_byte3)
+      return Fail(error, "invalid level 11 content type, whitepoint or reserved byte");
+    // libdovi exposes the decoded low-nibble whitepoint and reference flag.
+    const uint8_t bytes[4] = {b.content_type,
+        uint8_t(b.whitepoint | (b.reference_mode_flag ? 0x10 : 0)), b.reserved_byte2, 0};
+    if (!writer.Block(11, bytes, 4))
+      return Fail(error, "level 11 payload capacity exceeded");
+  }
+  if (ext.level254)
+  {
+    const uint8_t bytes[2] = {ext.level254->dm_mode, ext.level254->dm_version_index};
+    if (!writer.Block(254, bytes, 2))
+      return Fail(error, "level 254 payload capacity exceeded");
+  }
+  // Preserve CB1's order when it must synthesize an absent active-area block.
+  if (!ext.level5 && !writer.Words(5, margins, 4))
+    return Fail(error, "synthesized level 5 payload capacity exceeded");
+
+  result.packet_count = 1 + (result.payload_size > 119 ? (result.payload_size - 119 + 120) / 121 : 0);
+  if (result.packet_count > DVFEL_METADATA_MAX_PACKETS)
+    return Fail(error, "metadata packet capacity exceeded");
+  unsigned consumed = 0;
+  for (unsigned i = 0; i < result.packet_count; i++)
+  {
+    uint8_t* packet = result.packets + i * DVFEL_METADATA_PACKET_SIZE;
+    const unsigned type = result.packet_count == 1 ? 0 : i == 0 ? 1 :
+                          i + 1 == result.packet_count ? 3 : 2;
+    packet[0] = type << 6;
+    packet[1] = (metadata_id << 4) | metadata_id;
+    const unsigned start = i ? 3 : 5;
+    const unsigned room = 124 - start;
+    const unsigned remaining = result.payload_size - consumed;
+    const unsigned take = remaining < room ? remaining : room;
+    if (!i)
+      Put16(packet + 3, result.payload_size);
+    std::memcpy(packet + start, result.payload + consumed, take);
+    consumed += take;
+    Put32(packet + 124, dvfel_metadata_crc(packet, 124));
+  }
+  *out = result;
+  return true;
+}
